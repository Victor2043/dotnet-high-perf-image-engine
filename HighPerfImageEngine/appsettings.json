{
    "Logging": {
        "EnableUiLogs": false,
        "EnableResultTable": false,
        "LogIntervalMessages": 500
    },
    "RabbitMq": {
        "MainExchange": "image.events",
        "MainQueue": "image.processing.queue",
        "MainRoutingKey": "image.process",
        "DlxExchange": "image.events.dlx",
        "DlqQueue": "image.processing.dlq",
        "DlqRoutingKey": "image.process.dlq",
        "MaxRetryCount": 3,
        "PrefetchCount": 100
    },
    "Processing": {
        "DegreeOfParallelism": 2,
        "ChannelCapacity": 2
    },
    "Persistence": {
        "SaveSampleToDisk": false,
        "SampleEveryNthMessage": 2000
    }
}